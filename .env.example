# Three different identities live in this file, and they are easy to confuse:
#   SOMA_ALLOWED_EMAILS  — who may READ your data
#   SOMA_GOOGLE_*        — the OAuth app that proves who they are
#   SOMA_GARMIN_EMAIL    — the account this system reads FROM

# ==== Serving ====
SOMA_HOST=127.0.0.1
SOMA_PORT=8000
SOMA_DB_PATH=./data/soma.db

# ==== Who may call this server ====
# Google OAuth, for the deployed HTTP server. Register the redirect URI
#   <SOMA_BASE_URL>/auth/callback
# in the Google Cloud console, and keep the app Published / In production.
SOMA_OAUTH_ENABLED=true
SOMA_GOOGLE_CLIENT_ID=
SOMA_GOOGLE_CLIENT_SECRET=

# Public origin. Pinned here rather than read from x-forwarded-host, so a
# spoofed header cannot redirect the OAuth flow somewhere else.
# Production. Must match a redirect URI registered with Google, as
# <SOMA_BASE_URL>/auth/callback. Changing it means re-registering.
SOMA_BASE_URL=https://soma.hwhub.dev

# For local OAuth work, point this at the dev hostname and register
# https://soma-dev.hwhub.dev/auth/callback as a second redirect URI. Google
# accepts several per client, so dev and production coexist on one client.
# The container publishes 127.0.0.1:8181, so a tunnel for soma-dev reaches it
# there.
#   SOMA_BASE_URL=https://soma-dev.hwhub.dev

# Signs the tokens this server issues. Generate one:
#   openssl rand -hex 32
# Rotating it signs every live session out.
SOMA_JWT_SIGNING_KEY=

# Google sign-in proves identity, not authorisation — without this list, any
# Google account on earth completes the flow. The server refuses to start when
# OAuth is on and this is empty. Comma-separated.
SOMA_ALLOWED_EMAILS=you@example.com

# Static bearer token, for local development and the stdio server. Ignored when
# OAuth is configured. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SOMA_API_TOKEN=

# ==== Garmin ingestion ====
# Garmin is the only source for sleep, HRV, Body Battery and resting HR.
# Email only. Your password is entered interactively during `garmin-auth` and is
# NEVER stored here or on disk — only the resulting OAuth tokens are.
SOMA_GARMIN_EMAIL=
SOMA_GARMIN_TOKENSTORE=./data/garmin_tokens

# How many days back to sync. 365 = keep a rolling year. Pair with
# `garmin-sync --skip-existing` so only new/recent days are fetched each run.
SOMA_GARMIN_SYNC_DAYS_BACK=365
# Seconds between sync runs in the compose loop. 86400 = nightly.
SOMA_GARMIN_INTERVAL_S=86400

# Garmin's SSO limit is PER ACCOUNT, not per IP — changing network or user agent
# does nothing, only time clears it. `garmin-auth` refuses to attempt another
# credential login inside this window.
SOMA_GARMIN_LOGIN_COOLDOWN_S=900

# ==== Deployment: Cloudflare Tunnel ====
# Create the tunnel in the Cloudflare Zero Trust dashboard, route your hostname
# to http://server:8000, and paste the token here. Do NOT put Cloudflare Access
# in front of the hostname — see deploy/RASPBERRY_PI.md.
CLOUDFLARE_TUNNEL_TOKEN=

# Image to run on the Pi. Override to build locally instead.
# SOMA_IMAGE=ghcr.io/aidiaz/soma:latest

# ---------------------------------------------------------------------------
# Wahoo Cloud API. Not read by any code yet — ingest/wahoo/ is unbuilt (#3).
# Put the real values in .env, never here. .env is gitignored; this file is not.
#
#   authorize  https://api.wahooligan.com/oauth/authorize
#   token      https://api.wahooligan.com/oauth/token
#
# The redirect URI must match one registered on the app in Wahoo's developer
# portal, exactly. Wahoo gates production use behind an approval, so credentials
# existing does not mean the flow works yet — see #3.
#
# Scope note: workouts_read is the one that carries power_bike_tss_last, which
# is the whole reason for this integration. power_zones_read only adds FTP and
# zone thresholds; 4DP is not exposed by the API at all.
# SOMA_WAHOO_CLIENT_ID=
# SOMA_WAHOO_CLIENT_SECRET=
# Must be HTTPS and match the app registration byte for byte. Wahoo rejects a
# localhost callback, so this points at the deployed server.
# SOMA_WAHOO_REDIRECT_URI=https://soma.example.dev/callback
# SOMA_WAHOO_TOKENSTORE=./data/wahoo_tokens.json
# SOMA_WAHOO_SYNC_DAYS_BACK=365
# How often the wahoo-sync loop runs, in seconds. Hourly by default: a trainer
# session should be readable the evening it happens.
# SOMA_WAHOO_INTERVAL_S=3600
